# Copy to .env for local development. Real environment variables override
# the values in this file. Never commit a real .env file.

# Application
APP_NAME=rombong-api
APP_ENV=development          # development | production
APP_PORT=8080
LOG_LEVEL=info               # debug | info | warn | error
AUTO_MIGRATE=true            # apply SQL migrations on startup
BCRYPT_COST=12

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis (cache + rate limiter; the API keeps working when it is down)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT. Generate a secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# CORS: comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:3000

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Cache TTLs
CACHE_PRODUCT_TTL=10m
CACHE_PRODUCT_LIST_TTL=2m

# Payments
PAYMENT_EXPIRY=30m
# simulated (default, no real money) or midtrans
PAYMENT_PROVIDER=simulated
# Midtrans Snap server key (Dashboard > Settings > Access Keys). Sandbox keys start with SB-Mid-server-
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Seed admin account, created on startup if it does not exist.
# Leave ADMIN_EMAIL empty to skip seeding.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
